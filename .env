# ==============================================================================
# APPLICATION CONFIGURATION
# ==============================================================================
APP_NAME="My Awesome App"
APP_ENV=development                       # Options: development, staging, production
APP_KEY=base64:yjY8UdaHRvUzR2pXQzFzYTM0NTY3ODkwMTI=
APP_DEBUG=true                            # Set to false in production
APP_URL=http://localhost:3000
APP_PORT=3000

# ==============================================================================
# DATABASE CONFIGURATION (Relational / NoSQL)
# ==============================================================================
DB_CONNECTION=postgresql                  # postgresql, mysql, mongodb, sqlite
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=my_app_db
DB_USERNAME=db_user
DB_PASSWORD=super_secret_password_123

# Redis Cache / Session Store
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ==============================================================================
# AUTHENTICATION & SECURITY (JWT, OAuth)
# ==============================================================================
JWT_SECRET=xyz_random_jwt_secret_string_here
JWT_EXPIRATION_TIME=1h

# Third-Party OAuth (Google Example)
GOOGLE_CLIENT_ID=://googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ==============================================================================
# MAIL / SMTP SERVER
# ==============================================================================
MAIL_MAILER=smtp
MAIL_HOST=sandbox.smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=your_smtp_username
MAIL_PASSWORD=your_smtp_password
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="noreply@myawesomeapp.com"
MAIL_FROM_NAME="${APP_NAME}"

# ==============================================================================
# EXTERNAL APIS & THIRD-PARTY SERVICES
# ==============================================================================
# Payment Gateway (Stripe Example)
STRIPE_KEY=pk_test_51Nx...
STRIPE_SECRET=sk_test_51Nx...

# Cloud Storage (AWS S3 Example)
AWS_ACCESS_KEY_ID=AKIAIOSFODNN7EXAMPLE
AWS_SECRET_ACCESS_KEY=wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=my-app-assets-bucket

# ==============================================================================
# LOGGING & MONITORING
# ==============================================================================
LOG_CHANNEL=stack                         # daily, slack, syslogs
LOG_LEVEL=debug                           # debug, info, warning, error

SENTRY_DSN=https://sentry.io
